## ASCII art for every entity. Sprites face right and are mirrored when facing left.
## Rows are bottom-aligned on the entity's feet; "a" is the column drawn at the
## entity's centre. Colours come from "pal": either a per-row mask of palette
## digits ("m") or a glyph-to-palette map ("cmap"); anything else uses pal[0].
extends RefCounted

const MIRROR := {
	"/": "\\", "\\": "/", "<": ">", ">": "<", "(": ")", ")": "(", "[": "]", "]": "[",
	"{": "}", "}": "{", "d": "b", "b": "d", "p": "q", "q": "p", "J": "L", "L": "J", "´": "`", "`": "´",
}

