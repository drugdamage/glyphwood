# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{gd,gdshader,gdshaderinc}]
indent_style = tab
indent_size = 4

[*.{tscn,tres,cfg,godot,import}]
# Written by the Godot editor; leave formatting alone
trim_trailing_whitespace = false
insert_final_newline = false

[*.md]
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
