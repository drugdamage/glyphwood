# Normalize line endings: everything text is stored and checked out as LF
* text=auto eol=lf

# Godot text formats
*.gd       text eol=lf
*.gdshader text eol=lf
*.tscn     text eol=lf
*.tres     text eol=lf
*.cfg      text eol=lf
*.import   text eol=lf
*.uid      text eol=lf
*.godot    text eol=lf

# Binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.icns binary
*.ttf  binary
*.otf  binary
*.woff binary
*.woff2 binary
*.wav  binary
*.ogg  binary
*.mp3  binary
*.zip  binary

# GitHub language stats: docs and media are not code
docs/** linguist-documentation
